# ===========================================
# XENTECK SPEED-TO-LEAD ENVIRONMENT VARIABLES
# ===========================================

# Upstash Redis (get from upstash.com - FREE tier)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Twilio SMS (get from twilio.com/console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google OAuth (Gmail + Calendar)
# Set up at console.cloud.google.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token

# App Configuration
NEXT_PUBLIC_APP_URL=https://stl.xenteck.com
AGENT_NAME=Shaun
AGENT_EMAIL=admin@xenteck.com

# Dedupe Window (seconds) - prevents double-contact within this window
DEDUPE_WINDOW_SECONDS=300
