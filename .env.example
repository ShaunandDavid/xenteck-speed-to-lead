# ===========================================
# XENTECK SPEED-TO-LEAD ENVIRONMENT VARIABLES
# ===========================================

# Upstash Redis (get from upstash.com - FREE tier)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Telnyx SMS (get from portal.telnyx.com)
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_FROM_NUMBER=+18888530077

# SendGrid Email (get from sendgrid.com)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=support@xenteck.com
SENDGRID_FROM_NAME=XenTeck

# Calendar Link (static - no API call needed)
CALENDAR_LINK=https://calendar.app.google/8D2uSEALucdV3Krz9

# App Configuration
NEXT_PUBLIC_APP_URL=https://stl.xenteck.com
AGENT_NAME=Shaun

# Dedupe Window (seconds) - prevents double-contact within this window
DEDUPE_WINDOW_SECONDS=300

# ===========================================
# LEGACY - Twilio (unused)
# ===========================================
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
